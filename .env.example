# Copie este arquivo para ".env.local" e preencha com os dados do seu projeto Supabase
# (Supabase > Project Settings > API)

NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
SUPABASE_SERVICE_ROLE_KEY=cole-aqui-a-service-role-key

# Segredo usado para assinar os cookies de sessão (acesso geral e
# Financeiro). Gere um valor aleatório, por exemplo rodando: openssl rand -hex 32
FINANCEIRO_SESSION_SECRET=troque-por-um-valor-aleatorio-longo

# Senha única para ENTRAR no sistema inteiro (protege o site de qualquer
# pessoa que descubra o link, antes mesmo de chegar na tela de login).
# Escolha uma senha e coloque ela aqui, sem espaços em branco no início/fim.
ACESSO_SENHA=escolha-uma-senha-de-acesso

# Senha da aba Financeiro continua igual: NÃO fica aqui, é configurada
# rodando "npm run hash-senha" e colando o SQL gerado no Supabase (veja o README).
